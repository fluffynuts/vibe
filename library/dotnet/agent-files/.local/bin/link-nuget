#!/bin/sh
# vibe: description: Tell NuGet where the host's packages are, if they were mounted
# vibe passes SBX_HOST_NUGET_PACKAGES when it mounts the host's package cache
# (read-only), or SBX_HOST_NUGET when settings say "nuget: shared" and all of
# the host's ~/.nuget is mounted. No braced shell expansions here: sbx
# validates every brace-form substitution in file content against its own
# placeholder list.
LOG=/tmp/link-nuget.log
if [ -n "$SBX_LINK_NUGET_LOG" ]; then
  LOG=$SBX_LINK_NUGET_LOG
fi
exec >>"$LOG" 2>&1
echo "=== link-nuget at $(date -Is) ==="

PERSIST=/etc/sandbox-persistent.sh
if [ -n "$SBX_PERSIST_FILE" ]; then
  PERSIST=$SBX_PERSIST_FILE
fi

# Written to the persistent env file rather than passed at create time so it
# cannot go missing on a sandbox created before this change. Replaces any
# line for the same variable, so a rebuilt sandbox never keeps the old ones.
persist() {
  name=$1
  want="export $name=$2"
  if [ -f "$PERSIST" ] && grep -qxF "$want" "$PERSIST"; then
    echo "$name already persisted"
    return
  fi
  edit="sed -i '/^export $name=/d' '$PERSIST' 2>/dev/null; echo '$want' >> '$PERSIST'"
  if [ -w "$PERSIST" ]; then
    sh -c "$edit"
  else
    sudo sh -c "$edit"
  fi && echo "persisted: $want" || echo "WARN: could not write $PERSIST"
}

unpersist() {
  if [ -f "$PERSIST" ] && grep -q "^export $1=" "$PERSIST"; then
    if [ -w "$PERSIST" ]; then
      sed -i "/^export $1=/d" "$PERSIST"
    else
      sudo sed -i "/^export $1=/d" "$PERSIST"
    fi && echo "removed $1 from $PERSIST"
  fi
}

# Overlays the host's cache (read-only) at its own path, with what the
# sandbox writes kept in the sandbox. restore bakes the cache's path into
# obj/project.assets.json and the *.nuget.g.props files, so with the host's
# path here the host's IDE resolves what the sandbox restored, once the host
# has the package (see the Admin tab's sync). Says whether it did; a sandbox
# that can't keeps the host's cache as a fallback beside its own.
# The upper layer needs a disk that isn't itself an overlay, which the
# sandbox's root is: /var/lib/docker is one. It's the agent's: this runs as
# root when the sandbox is set up, and a root-owned upper layer leaves NuGet
# unable to write a package. SBX_NUGET_UPPER_BASE and
# SBX_PROC_MOUNTS are for tests.
overlay_packages() {
  lower=$1
  base=$SBX_NUGET_UPPER_BASE
  if [ -z "$base" ]; then
    base=/var/lib/docker/vibe-nuget
  fi
  mounts=$SBX_PROC_MOUNTS
  if [ -z "$mounts" ]; then
    mounts=/proc/mounts
  fi
  # Ours, by its upper layer: a bind of a folder on an overlay is one too.
  if grep "^overlay $lower overlay " "$mounts" 2>/dev/null | grep -q "upperdir=$base/upper"; then
    echo "$lower is already an overlay"
    return 0
  fi
  # overlayfs splits its options on commas and colons.
  case "$lower" in
    *,* | *:*)
      echo "not overlaying $lower: overlayfs can't take a comma or colon in a path"
      return 1
      ;;
  esac
  if [ ! -d "$(dirname "$base")" ]; then
    echo "not overlaying $lower: no disk at $(dirname "$base") to keep what is written"
    return 1
  fi
  if ! sudo mkdir -p "$base/upper" "$base/work" || ! sudo chown agent: "$base/upper"; then
    echo "not overlaying $lower: could not make $base"
    return 1
  fi
  if err=$(sudo mount -t overlay overlay -o "lowerdir=$lower,upperdir=$base/upper,workdir=$base/work" "$lower" 2>&1); then
    echo "overlaid $lower: the host's packages below (read-only), writes in $base/upper"
    return 0
  fi
  echo "not overlaying $lower: mount said: $err"
  return 1
}

if [ -n "$SBX_HOST_NUGET" ]; then
  # Shared: ~/.nuget is the host's, and restore bakes absolute package
  # paths into obj/project.assets.json. Left to itself NuGet resolves via
  # HOME, giving /home/agent/.nuget, which does not exist on the host — so
  # Rider cannot resolve a single package after a container build. Pinning
  # both sides to the host path keeps the generated files identical.
  if [ ! -d "$SBX_HOST_NUGET" ]; then
    echo "ERROR: $SBX_HOST_NUGET is not mounted"
    exit 1
  fi
  LINK=/home/agent/.nuget
  if [ -n "$SBX_NUGET_LINK" ]; then
    LINK=$SBX_NUGET_LINK
  fi
  if [ -L "$LINK" ]; then
    ln -sfn "$SBX_HOST_NUGET" "$LINK"
  elif [ -e "$LINK" ]; then
    echo "WARN: $LINK exists and is not a symlink; moving aside"
    mv "$LINK" "$LINK.local" && ln -s "$SBX_HOST_NUGET" "$LINK"
  else
    ln -s "$SBX_HOST_NUGET" "$LINK"
  fi
  echo "linked $LINK -> $(readlink "$LINK")"
  persist NUGET_PACKAGES "$SBX_HOST_NUGET/packages"
  unpersist NUGET_FALLBACK_PACKAGES
  unpersist RestoreIgnoreFailedSources
  unpersist VIBE_NUGET_OVERLAY
elif [ -n "$SBX_HOST_NUGET_PACKAGES" ]; then
  if [ ! -d "$SBX_HOST_NUGET_PACKAGES" ]; then
    echo "ERROR: $SBX_HOST_NUGET_PACKAGES is not mounted"
    exit 1
  fi
  if overlay_packages "$SBX_HOST_NUGET_PACKAGES"; then
    persist NUGET_PACKAGES "$SBX_HOST_NUGET_PACKAGES"
    persist VIBE_NUGET_OVERLAY 1
    unpersist NUGET_FALLBACK_PACKAGES
  else
    # The host's cache is read-only, and a fallback: packages found there
    # are used in place, anything else lands in the sandbox's own
    # ~/.nuget/packages.
    persist NUGET_FALLBACK_PACKAGES "$SBX_HOST_NUGET_PACKAGES"
    unpersist NUGET_PACKAGES
    unpersist VIBE_NUGET_OVERLAY
  fi
  # A private feed the sandbox can't sign in to is a warning, not a failed
  # restore: what it holds is asked of the host (vibe-nuget fetch).
  persist RestoreIgnoreFailedSources true
else
  echo "SBX_HOST_NUGET and SBX_HOST_NUGET_PACKAGES unset — nothing to do"
fi
