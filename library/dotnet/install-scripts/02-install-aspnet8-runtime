#!/bin/sh
# vibe: description: Add the .NET 8 ASP.NET Core runtime so net8.0 tests can run (non-fatal)
# vibe: user: 0
LOG="${DOTNET_INSTALL_LOG:-/tmp/sbx-setup.log}"
echo "--- installing .NET 8 ASP.NET Core runtime $(date -Is)" >>"$LOG"
# dotnet-install.sh is fetched with curl over https and its archive unpacked with tar: the image doesn't promise them.
need=""
command -v curl >/dev/null 2>&1 || need="$need curl"
command -v tar >/dev/null 2>&1 || need="$need tar"
[ -s "${DOTNET_CA_BUNDLE:-/etc/ssl/certs/ca-certificates.crt}" ] || need="$need ca-certificates"
if [ -n "$need" ]; then
  # Not quoted: each is a package name.
  sudo DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 install -y $need </dev/null >>"$LOG" 2>&1 \
    || echo "WARN: couldn't install$need, which the .NET 8 runtime download needs" >>"$LOG"
fi
if command -v dotnet >/dev/null 2>&1; then
  root=$(dirname "$(readlink -f "$(command -v dotnet)")")
  echo "DOTNET_ROOT=$root" >>"$LOG"
  curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh >>"$LOG" 2>&1 \
    && sudo bash /tmp/dotnet-install.sh --runtime aspnetcore --channel 8.0 --install-dir "$root" --no-path </dev/null >>"$LOG" 2>&1 \
    || echo "WARN: .NET 8 runtime install failed" >>"$LOG"
else
  echo "WARN: no dotnet on PATH, skipping .NET 8 runtime" >>"$LOG"
fi
true
