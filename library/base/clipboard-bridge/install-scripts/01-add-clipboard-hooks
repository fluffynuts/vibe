#!/bin/sh
# vibe: description: web-based clipboard bridge - use if you have trouble pasting into the agent console
# vibe: user: 0
# vibe: registers: clipboard-hook
# Managed settings rather than ~/.claude/settings.json, for the same reason
# as diffity's URL hooks: that file is the user's, deployed only-if-missing
# after install steps have run. Claude Code merges the hooks of every
# managed-settings.d drop-in with the user's.
# UserPromptSubmit hands over what was pasted with the user's next message.
# Not mid-turn (PostToolUse, say): a paste then reached the agent with no
# word of what it was for, before the user could even title it.
# The hook script itself is an agent-file, not on disk yet — which is fine,
# since nothing runs it until the agent's first session.
DIR=/etc/claude-code/managed-settings.d
mkdir -p "$DIR" || { echo "WARN: could not create $DIR" >>/tmp/sbx-setup.log; exit 0; }
cat >"$DIR/50-vibe-clipboard.json" <<'JSON' || echo "WARN: could not register the clipboard hooks" >>/tmp/sbx-setup.log
{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "/home/agent/.local/bin/clipboard-hook", "timeout": 5 }]
      }
    ]
  }
}
JSON
chmod 644 "$DIR/50-vibe-clipboard.json" 2>/dev/null
true
