#!/bin/sh
# vibe: description: Install Node.js, which runs the clipboard page's server (non-fatal)
# vibe: user: 0
# sbx's claude kit installs Claude natively and no longer brings node along,
# and start-clipboard refuses to start the page without it.
LOG="${NODE_INSTALL_LOG:-/tmp/sbx-setup.log}"
if command -v node >/dev/null 2>&1; then
  exit 0
fi
echo "--- installing Node.js $(date -Is)" >>"$LOG"
apt_install() {
  sudo DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 "$@" </dev/null >>"$LOG" 2>&1
}
# nodejs-24 is the Docker Hardened Images package; plain nodejs is Debian's.
apt_install install -y nodejs-24 \
  || { apt_install update && apt_install install -y nodejs-24; } \
  || apt_install install -y nodejs \
  || echo "WARN: Node.js install failed: the clipboard page won't start" >>"$LOG"
true
