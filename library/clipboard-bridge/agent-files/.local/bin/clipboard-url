#!/bin/sh
# vibe: description: Print the host URL of the clipboard page
# vibe: startup: false
# The page listens on 5390 inside the sandbox, but the port the user reaches
# it on is allocated on the host and differs between sandboxes, so it can
# only be known from outside. vibe writes it, checked against sbx's live port
# mappings, to the published/clipboard file below at every session start;
# VIBE_CLIPBOARD_URL, fixed when the sandbox was created, is the fall-back.
# Anything short of a confirmed URL is printed with a warning on stderr.
# No braced shell expansions here: sbx validates every brace-form
# substitution in file content against its own placeholder list.
#
# With --if-ready it first checks the page is up: that the server listens on
# 5390, and that vibe has written the URL since the sandbox booted (a file
# from an earlier boot may name a port that has since changed). Until both
# hold it prints nothing and exits 3, so the status band can say the page is
# still starting rather than hand out a URL that doesn't load yet.
published=/home/agent/.local/state/vibe/published/clipboard
if [ "$1" = --if-ready ]; then
  # 5390 is 150E in hex; 0A is LISTEN.
  cat /proc/net/tcp /proc/net/tcp6 2>/dev/null \
    | awk '$2 ~ /:150E$/ && $4 == "0A" { f = 1 } END { exit f ? 0 : 1 }' \
    || exit 3
  booted=$(awk '$1 == "btime" { print $2 }' /proc/stat)
  written=$(stat -c %Y "$published" 2>/dev/null)
  [ -n "$written" ] && [ "$written" -ge "$booted" ] || exit 3
fi
url=
if [ -s "$published" ]; then
  url=$(sed -n 1p "$published")
  note=$(sed -n 's/^unverified: //p' "$published")
  if [ -n "$note" ]; then
    echo "warning: unverified — $note" >&2
  fi
fi
if [ -z "$url" ]; then
  url=$VIBE_CLIPBOARD_URL
  if [ -n "$url" ]; then
    echo "warning: unverified — vibe has not confirmed this port with sbx this session;" >&2
    echo "         it is the one recorded when the sandbox was created" >&2
  fi
fi
if [ -z "$url" ]; then
  url=http://localhost:5390
  echo "warning: no host URL is known — this is the container's own port," >&2
  echo "         which is not necessarily what the host publishes it on" >&2
fi
printf '%s\n' "$url"
