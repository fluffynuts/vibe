#!/bin/sh
# vibe: description: Install the diffity review viewer CLI (non-fatal)
# vibe: user: 0
# Self-contained on purpose: setup.files are not deployed until setup.install
# has finished, so an install script that calls a helper from agent-files runs
# before that helper exists and fails with "not found" every single time.
# agent-files scripts are for startup (on-start) and for running by hand.
# Its startup counterpart is agent-files/.local/bin/update-diffity, which
# keeps the version current for the life of the sandbox; keep the two in step.
echo "--- npm install -g diffity $(date -Is)" >>/tmp/sbx-setup.log
npm install -g diffity >>/tmp/sbx-setup.log 2>&1 \
  || echo "WARN: diffity install failed" >>/tmp/sbx-setup.log
true
