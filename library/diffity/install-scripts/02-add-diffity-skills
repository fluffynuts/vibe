#!/bin/sh
# vibe: description: Install diffity's agent skills (non-interactive, non-fatal)
# vibe: user: 1000
# Self-contained for the same reason as 01-install-diffity-cli: agent-files
# are not on disk yet while install steps run.
# Its startup counterpart is agent-files/.local/bin/update-diffity-skills,
# which repeats this work on every start; keep the two in step.
LOG=/tmp/sbx-setup.log
SKILLS=/home/agent/.claude/skills

echo "--- diffity skills install $(date -Is)" >>$LOG
cd /home/agent || exit 0
# The fork bundles its skills and unpacks them into ~/.claude/skills itself,
# replacing only the diffity-* directories it owns.
diffity skills install >>$LOG 2>&1 \
  || echo "WARN: diffity skills install failed" >>$LOG

{ echo "--- skills present:"; ls "$SKILLS"; } >>$LOG 2>&1
ls "$SKILLS" 2>/dev/null | grep -q . || echo "WARN: no diffity skills installed" >>$LOG
true
