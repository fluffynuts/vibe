#!/bin/sh
# vibe: description: Claude Code hook: every reply that used diffity ends with the URL the user can open
# vibe: startup: false
# Registered for every session by install-scripts/03-add-diffity-url-hooks;
# the work is done by ~/.local/share/vibe/diffity-url-hook.js. Always exits
# 0: a hook that fails must not get in the agent's way.
script=/home/agent/.local/share/vibe/diffity-url-hook.js
[ -f "$script" ] || exit 0
# Hooks inherit the agent's environment, which may not have been through
# the persistent env file where a node version manager records itself.
if ! command -v node >/dev/null 2>&1 && [ -f /etc/sandbox-persistent.sh ]; then
  . /etc/sandbox-persistent.sh >/dev/null 2>&1
fi
command -v node >/dev/null 2>&1 || exit 0
node "$script"
exit 0
