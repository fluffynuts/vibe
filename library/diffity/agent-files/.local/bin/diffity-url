#!/bin/sh
# vibe: description: Print the host URL for the diffity viewer, for a ref if given
# vibe: startup: false
# The viewer listens on 5391 inside the sandbox, but the port the user reaches
# it on is allocated on the host and differs between sandboxes, so it can
# only be known from outside. vibe writes it, checked against sbx's live port
# mappings, to the published/diffity file below at every session start;
# VIBE_DIFFITY_URL, fixed when the sandbox was created, is the fall-back.
# Anything short of a confirmed URL is printed with a warning on stderr.
# No braced shell expansions here: sbx validates every brace-form
# substitution in file content against its own placeholder list.
published=/home/agent/.local/state/vibe/published/diffity
url=
if [ -s "$published" ]; then
  url=$(sed -n 1p "$published")
  note=$(sed -n 's/^unverified: //p' "$published")
  if [ -n "$note" ]; then
    echo "warning: unverified — $note" >&2
  fi
fi
if [ -z "$url" ]; then
  url=$VIBE_DIFFITY_URL
  [ -n "$url" ] || url=$SBX_CC_DIFFITY_URL # sandboxes created by the old vibe.sh
  if [ -n "$url" ]; then
    echo "warning: unverified — vibe has not confirmed this port with sbx this session;" >&2
    echo "         it is the one recorded when the sandbox was created" >&2
  fi
fi
if [ -z "$url" ]; then
  url=http://localhost:5391
  echo "warning: no host URL is known — this is the container's own port," >&2
  echo "         which is not necessarily what the host publishes it on" >&2
fi
# The ref goes on /diff, not the root: the root redirects to /diff and drops
# the query, and terminals stop linkifying a path-less URL at the ".." of a
# range like master..HEAD. With no ref it is still /diff: the full address,
# for the uncommitted changes.
if [ -n "$1" ]; then
  out=$url/diff?ref=$1
else
  out=$url/diff
fi
# The latest URL given out is what vibe-band shows as "review at:". The hook
# asks for the base URL to brief the agent; that is not one given to the user.
if [ -z "$VIBE_DIFFITY_URL_NO_RECORD" ]; then
  mkdir -p /home/agent/.local/state/vibe 2>/dev/null &&
    printf '%s\n' "$out" > /home/agent/.local/state/vibe/diffity-review-url 2>/dev/null
fi
printf '%s\n' "$out"
