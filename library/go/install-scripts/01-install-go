#!/bin/sh
# vibe: description: Install Go (non-fatal)
# vibe: user: 0
# golang-1.26 is the Docker Hardened Images package; it keeps its tools in
# /usr/lib/go-1.26/bin, which no shell has on its PATH, so they are linked
# from /usr/local/bin, which every shell has (an agent's included). A go.mod
# that wants a newer Go than this one has its toolchain downloaded by go
# itself on first use.
LOG="${GO_INSTALL_LOG:-/tmp/sbx-setup.log}"
BIN="${GO_BIN:-/usr/lib/go-1.26/bin}"
LINKS="${GO_LINKS:-/usr/local/bin}"
if command -v go >/dev/null 2>&1; then
  exit 0
fi
echo "--- installing Go $(date -Is)" >>"$LOG"
apt_install() {
  sudo DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 "$@" </dev/null >>"$LOG" 2>&1
}
apt_install install -y golang-1.26 \
  || { apt_install update && apt_install install -y golang-1.26; } \
  || { echo "WARN: Go install failed: there is no go" >>"$LOG"; exit 0; }
for tool in go gofmt; do
  sudo ln -sf "$BIN/$tool" "$LINKS/$tool" || echo "WARN: could not link $tool into $LINKS" >>"$LOG"
done
true
