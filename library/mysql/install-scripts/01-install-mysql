#!/bin/sh
# vibe: description: Install a MySQL-compatible server (MariaDB) and the file utility
# vibe: user: 0
# The image is Debian, which has no mysql-server: default-mysql-server is
# MariaDB under the MySQL names (mysqld, mysql and mysqladmin are all there), and
# its install sets up the data folder.
LOG="${MYSQL_INSTALL_LOG:-/tmp/sbx-setup.log}"
echo "--- installing a MySQL-compatible server, file util $(date -Is)" >>"$LOG"
sudo DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 install -y default-mysql-server file </dev/null >>"$LOG" 2>&1 \
  || echo "WARN: the MySQL-compatible server install failed" >>"$LOG"
command -v mysqld >/dev/null 2>&1 || echo "WARN: no mysqld on the PATH after the install" >>"$LOG"
true
