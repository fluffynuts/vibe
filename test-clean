#!/bin/bash
# Rebuild vibe from this checkout, refresh ~/.vibe from it, and re-compose
# the sandbox for the folder this is run from.
VIBE_FOLDER="$(dirname "$(readlink -f "$0")")"
VIBE="$VIBE_FOLDER/vibe"

rm -f "$VIBE"
make -C "$VIBE_FOLDER" && \
  "$VIBE" --stop -f && \
  "$VIBE" --install && \
  "$VIBE" -C -f --no-start && \
  "$VIBE" --headless
