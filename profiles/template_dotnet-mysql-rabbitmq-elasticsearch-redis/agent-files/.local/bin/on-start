#!/bin/sh
# vibe: description: Update diffity and its skills, link nuget, start RabbitMQ & Elasticsearch
exec >>/tmp/start-services.log 2>&1
echo "=== start-services at $(date -Is) ==="
for s in update-diffity update-diffity-skills link-nuget start-rabbit start-elasticsearch; do
  echo "--- $s"
  /home/agent/.local/bin/$s || echo "WARN: $s exited $?"
done
echo "=== done at $(date -Is) ==="
