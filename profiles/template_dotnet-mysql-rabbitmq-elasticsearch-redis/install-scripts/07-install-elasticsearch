#!/bin/sh
# vibe: description: Install Elasticsearch (no Ubuntu package exists)
# vibe: user: 0
echo "--- installing elasticsearch $(date -Is)" >>/tmp/sbx-setup.log
sudo DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 install -y elasticsearch </dev/null >>/tmp/sbx-setup.log 2>&1 \
  || echo "WARN: elasticsearch install failed" >>/tmp/sbx-setup.log
true
