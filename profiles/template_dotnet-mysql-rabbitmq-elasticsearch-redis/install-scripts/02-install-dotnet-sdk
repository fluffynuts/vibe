#!/bin/sh
# vibe: description: Install the .NET 10 SDK from the distro (non-fatal)
# vibe: user: 0
echo "--- installing dotnet-sdk-10.0 $(date -Is)" >>/tmp/sbx-setup.log
sudo DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=300 install -y dotnet-sdk-10.0 </dev/null >>/tmp/sbx-setup.log 2>&1 \
  || echo "WARN: dotnet-sdk-10.0 install failed" >>/tmp/sbx-setup.log
true
