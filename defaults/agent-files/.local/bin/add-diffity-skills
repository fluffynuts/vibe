#!/bin/sh
# vibe: description: Install diffity's agent skills and consolidate them into ~/.claude/skills
exec >>/tmp/add-diffity-skills.log 2>&1
echo "=== add-diffity-skills at $(date -Is) ==="
cd /home/agent && npx -y skills add nilbuild/diffity -- -y </dev/null

mkdir -p /home/agent/.claude/skills
for d in /home/agent/.agents/skills /home/agent/workspace/.agents/skills /home/agent/workspace/.claude/skills; do
  [ -d "$d" ] && cp -a "$d"/. /home/agent/.claude/skills/
done
echo "--- skills present:"
ls /home/agent/.claude/skills
